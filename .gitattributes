# Normalize line endings to LF in the repo.
* text=auto eol=lf

# Explicit LF for source files.
*.py     text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.cfg    text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Binary files - never normalize.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
*.pbix   binary
*.csv    -text
