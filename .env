# ---- PostgreSQL ----
POSTGRES_USER=cars
POSTGRES_PASSWORD=cars
POSTGRES_DB=cars
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- pgAdmin ----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ---- Bruin ----
# Bruin reads connection strings from its own config (.bruin.yml),
# which references these same POSTGRES_* variables.